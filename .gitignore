# 過去の手動バックアップフォルダ・アーカイブを除外
archives/v0_v1_notepad_prototypes/

# Python キャッシュ・仮想環境
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
node_modules/
*.egg-info/
.pytest_cache/

# 環境変数・機密情報
.env
*.env
*.pem
*.key

# PyInstaller ビルド生成物
build/
dist/
*.spec
*.spec.bak

# 大容量実行ファイル・配布アーカイブ（GitHub 50MB/100MB制限・リポジトリ肥大化防止）
*.exe
*.zip

# テスト用一時資産
**/test_assets/

# 実行時の一時ファイル・出力動画・録音・エラーログ
**/output/
**/recordings/
**/error_log.txt
*.mp4
*.wav

# temp フォルダ（組み込みデモMIDIは保護）
**/temp/*
!**/temp/demo_chromatic.mid

# OS固有・エディタ設定
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
